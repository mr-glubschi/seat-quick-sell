{
    "name": "mr-glubschi/seat-quick-sell",
    "description": "SeAT plugin: price items for selling at the market where you are and copy them into EVE's Sell Items window.",
    "type": "seat-plugin",
    "keywords": ["seat", "eve-online", "market", "sell"],
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/mr-glubschi/seat-quick-sell",
    "require": {
        "php": "^8.2",
        "eveseat/services": "^5.0",
        "eveseat/eveapi": "^5.0",
        "eveseat/web": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Glubschi\\Seat\\QuickSell\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Glubschi\\Seat\\QuickSell\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Glubschi\\Seat\\QuickSell\\QuickSellServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
